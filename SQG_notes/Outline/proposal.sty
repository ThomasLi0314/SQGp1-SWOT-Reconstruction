\usepackage[dvipsnames]{xcolor}

% --- Palette --------------------------------------------------
\definecolor{ProposalNavy}{HTML}{1B2A4A}    % Headings / rules
\definecolor{ProposalSteel}{HTML}{3E5C76}   % Sub-headings
\definecolor{ProposalAccent}{HTML}{D4A843}  % Accent highlights
\definecolor{ProposalBg}{HTML}{F5F1EB}      % Light warm background
\definecolor{ProposalLightBlue}{HTML}{DAE8F5}
\definecolor{ProposalLightGold}{HTML}{FDF6E3}

% ============================================================
%  TCOLORBOX
% ============================================================
\usepackage[most]{tcolorbox}

% ============================================================
%  PAGE GEOMETRY
% ============================================================
\usepackage{geometry}
\geometry{
    letterpaper,
    left   = 1in,
    right  = 1in,
    top    = 1in,
    bottom = 1in,
    headheight = 15pt,
    headsep    = 25pt,
    footskip   = 30pt
}

% ============================================================
%  SPACING
% ============================================================
\usepackage{setspace}
\setstretch{1.15}
\setlength{\parindent}{0pt}
\setlength{\parskip}{8pt}

% ============================================================
%  HEADER / FOOTER (fancyhdr)
% ============================================================
\usepackage{fancyhdr}

% Store metadata for headers/footers
\newcommand{\@proposaltitle}{Proposal Title}
\newcommand{\@proposalauthor}{Author}
\newcommand{\@proposaldate}{\today}
\newcommand{\@proposaladvisor}{}

\newcommand{\proposaltitle}[1]{\renewcommand{\@proposaltitle}{#1}}
\newcommand{\proposalauthor}[1]{\renewcommand{\@proposalauthor}{#1}}
\newcommand{\proposaldate}[1]{\renewcommand{\@proposaldate}{#1}}
\newcommand{\proposaladvisor}[1]{\renewcommand{\@proposaladvisor}{#1}}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[C]{\small\textcolor{ProposalSteel}{\textit{\@proposaltitle}}}
\fancyhead[R]{\small\textcolor{ProposalSteel}{\thepage}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{%
    \color{ProposalNavy}\leaders\hrule height \headrulewidth\hfill}}
\fancyfoot[C]{\small\textcolor{ProposalSteel}{\@proposalauthor}}

% ============================================================
%  HYPERREF
% ============================================================
\usepackage{hyperref}
\hypersetup{
    colorlinks  = true,
    linkcolor   = ProposalNavy,
    citecolor   = ProposalSteel,
    urlcolor    = ProposalAccent,
    pdfauthor   = {},
    pdftitle    = {},
}

% ============================================================
%  BIBLIOGRAPHY
% ============================================================
\usepackage[numbers, sort&compress]{natbib}

% ============================================================
%  TIKZ (for decorative title page rule)
% ============================================================
\usepackage{tikz}

% ============================================================
%  ENUMITEM – tighter lists
% ============================================================
\usepackage{enumitem}
\setlist{nosep, leftmargin=*}

% ============================================================
%  SECTION FORMATTING (titlesec)
% ============================================================
\usepackage{titlesec}

\titleformat{\section}
    {\Large\bfseries\color{ProposalNavy}}
    {\thesection.}{0.5em}{}
    [\vspace{2pt}{\color{ProposalNavy}\titlerule[0.8pt]}]

\titleformat{\subsection}
    {\large\bfseries\color{ProposalSteel}}
    {\thesubsection.}{0.5em}{}

\titleformat{\subsubsection}
    {\normalsize\bfseries\color{ProposalSteel}}
    {\thesubsubsection.}{0.5em}{}

\titlespacing*{\section}{0pt}{18pt}{8pt}
\titlespacing*{\subsection}{0pt}{12pt}{4pt}
\titlespacing*{\subsubsection}{0pt}{8pt}{4pt}

% ============================================================
%  TITLE PAGE COMMAND  –  \makeproposaltitle
% ============================================================
\newcommand{\makeproposaltitle}{%
    \thispagestyle{empty}
    \begin{center}
        \vspace*{1.5cm}

        % Decorative top rule
        {\color{ProposalAccent}\rule{0.6\textwidth}{1.2pt}}

        \vspace{0.8cm}

        {\Huge\bfseries\color{ProposalNavy}\@proposaltitle}

        \vspace{0.5cm}

        {\Large\color{ProposalSteel}\textsc{Project Outline}}

        \vspace{0.6cm}

        {\color{ProposalAccent}\rule{0.4\textwidth}{0.8pt}}

        \vspace{1cm}

        {\large
            \textbf{Author:} \@proposalauthor \\[6pt]
            \ifx\@proposaladvisor\empty\else
                \textbf{Advisor:} \@proposaladvisor \\[6pt]
            \fi
            \textbf{Date:} \@proposaldate
        }

        \vspace{1.5cm}

        {\color{ProposalAccent}\rule{0.6\textwidth}{1.2pt}}

        \vspace*{\fill}
    \end{center}
    \clearpage
}

% ============================================================
%  ABSTRACT ENVIRONMENT
% ============================================================
\renewenvironment{abstract}{%
    \begin{tcolorbox}[
        colback   = ProposalLightGold,
        colframe  = ProposalAccent,
        boxrule   = 0.8pt,
        arc       = 4pt,
        left      = 10pt,
        right     = 10pt,
        top       = 8pt,
        bottom    = 8pt,
        title     = {\bfseries\color{ProposalNavy}Abstract},
        fonttitle = \large,
        coltitle  = ProposalNavy,
        attach boxed title to top left = {yshift=-2mm, xshift=10pt},
        boxed title style = {
            colback   = ProposalLightGold,
            colframe  = ProposalAccent,
            boxrule   = 0.4pt,
            arc       = 2pt
        }
    ]
}{%
    \end{tcolorbox}%
}

% ============================================================
%  OBJECTIVE / METHODOLOGY / TIMELINE  BOXES
% ============================================================

% --- Generic proposal box (internal helper) ---
\newtcolorbox{proposalbox}[2][]{%
    colback      = #1,
    colframe     = ProposalNavy,
    boxrule      = 0.6pt,
    arc          = 4pt,
    left         = 8pt,
    right        = 8pt,
    top          = 6pt,
    bottom       = 6pt,
    title        = {\bfseries #2},
    fonttitle    = \normalsize,
    coltitle     = white,
    colbacktitle = ProposalNavy,
    toptitle     = 3pt,
    bottomtitle  = 3pt,
}

% --- Specific boxes ---
\newenvironment{objective}{%
    \begin{proposalbox}[ProposalLightBlue]{Objectives}%
}{%
    \end{proposalbox}%
}

\newenvironment{methodology}{%
    \begin{proposalbox}[white]{Methodology}%
}{%
    \end{proposalbox}%
}

\newenvironment{timeline}{%
    \begin{proposalbox}[ProposalLightGold]{Timeline \& Milestones}%
}{%
    \end{proposalbox}%
}

\newenvironment{deliverables}{%
    \begin{proposalbox}[white]{Deliverables}%
}{%
    \end{proposalbox}%
}

\newenvironment{background}{%
    \begin{proposalbox}[ProposalLightBlue]{Background \& Motivation}%
}{%
    \end{proposalbox}%
}

% ============================================================
%  MILESTONE TABLE HELPER
% ============================================================
%  Usage:  \begin{milestonetable}
%            Week 1--2 & Literature review \\
%            Week 3    & Implementation    \\
%          \end{milestonetable}
\newenvironment{milestonetable}{%
    \vspace{4pt}%
    \begin{center}%
    \begin{tabular}{>{\bfseries}l p{0.7\textwidth}}%
    \toprule
    \textbf{Period} & \textbf{Task / Milestone} \\%
    \midrule
}{%
    \bottomrule
    \end{tabular}%
    \end{center}%
    \vspace{4pt}%
}

% ============================================================
%  HIGHLIGHT / NOTE BOXES (inline)
% ============================================================
\newtcolorbox{proposalnote}[1][Note]{%
    colback   = ProposalLightGold,
    colframe  = ProposalAccent!80!black,
    boxrule   = 0.5pt,
    arc       = 3pt,
    left      = 8pt,
    right     = 8pt,
    top       = 5pt,
    bottom    = 5pt,
    fonttitle = \bfseries\small,
    coltitle  = ProposalNavy,
    title     = {#1},
}

